# Export these variables before npm start. No .env loader is required.
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=4173
HOST=127.0.0.1
# Public HTTPS URL, also supplied when building Android:
PUBLIC_URL=https://tv.example.com
# Optional, server-only: enables GitHub APK build dispatch from super admin
GITHUB_TOKEN=
GITHUB_REPOSITORY=savrdhtechnology-cloud/SAVRDH-TV-OS
GITHUB_REF=feat/android-tv-super-admin
